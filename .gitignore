.venv

# Python
/__pycache__/

# Generated model checkpoints
*.pt
*.pth
*.ckpt

# Model exports (keep in a separate model repository)
*.safetensors

# Training artifacts
/checkpoints/
/runs/
/outputs/

# Local training data
/data/
# data_dirs*.txt covers data_dirs.txt AND any backup/variant (data_dirs.bak.txt,
# data_dirs_exclude.txt, ...). data_dirs.tmp.txt is already tracked, and
# gitignore does not affect tracked files, so the template stays published.
/data_dirs*.txt
/cache/

# Kaggle upload archives. hanny-code.zip is shareable but build output, so it
# stays ignored and is regenerated by pack.py. hanny-data.zip contains the
# private corpus -- the source text plus the report block with real folder paths
# and the names of 15 secret-bearing files -- and the gitignored safety probes.
# .gitattributes routes archives to LFS, so an accidental `git add .` would push
# all of it. See pack.py, which builds both and refuses to ship a leak.
/hanny-code.zip
/hanny-data.zip
/hanny-kaggle.zip
/upload/

# artifacts.zip -- the bundle Cell 8 produces on Kaggle and you download back.
# It carries adapter_model.safetensors, which .gitattributes would route to LFS,
# so a `git add .` would push ~24 MB of weights to the LAN Gitea. The individual
# files it expands into are already ignored (checkpoints/, *.safetensors), but
# the zip itself is a loose file in the repo root and would not be.
/artifacts.zip
/m5-4b-artifacts.zip

# pack.py's local allowance list. Gitignored because an allowance has to live
# somewhere, and recording an accepted string in a tracked pack.py would put
# that string into git -- the exact thing the scan exists to prevent.
/pack.local.json

# Red-team probe prompts. These are short functional strings used to detect
# refusal behaviour, and none of them is harmful in itself -- but a file of
# them is exactly what HF's Content Policy describes as "content that attempts to generate malicious code", with
# suspension among the listed sanctions. Intention is irrelevant to an automated
# flag or a stranger reading a diff, so the specific phrasings stay local.
#
# Kept OUT of git, deliberately. It still ships to Kaggle inside
# hanny-data.zip (tar/zipfile build from an explicit list, not a directory
# sweep, so .gitignore is not consulted), and chateval.py falls back to
# evalsets/safety_probe_public.jsonl when the real file is absent. That is the
# point: a clone gets a working eval, your machine gets the exact one.
/evalsets/safety_probe.jsonl

# The user's own lore corpus and everything generated from it. This is other
# people's copyrighted writing -- wiki dumps, lore documents, book and game
# texts. It has no business in this repository's history even though the
# repository is private, because git history is forever and a clone is a copy.
#
# The negations at the bottom are load-bearing. `/lore/*.md` was written to
# catch stray Markdown dropped in lore/ itself, and it also matched the two
# files that are supposed to be tracked -- so the comment above was describing
# an intention the rules contradicted. Check any new ignore rule with
# `git check-ignore -v <file>` and confirm the ones you meant to keep are NOT
# listed.
/lore/corpus/
/lore/prompts/
/lore/probes/
/lore/generated/
/lore/*.md
!/lore/README.md
!/lore/_template.md
