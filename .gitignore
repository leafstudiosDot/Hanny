.venv

# Python
/__pycache__/

# Generated model checkpoints
*.pt
*.pth
*.ckpt

# Model exports (keep in a separate model repository)
*.safetensors

# Training artifacts
/checkpoints/
/runs/
/outputs/

# Local training data
/data/
# data_dirs*.txt covers data_dirs.txt AND any backup/variant (data_dirs.bak.txt,
# data_dirs_exclude.txt, ...). data_dirs.tmp.txt is already tracked, and
# gitignore does not affect tracked files, so the template stays published.
/data_dirs*.txt
/cache/

# Kaggle upload archive. Contains the private corpus -- the source text plus the
# report block with real folder and secret-file paths -- and .gitattributes
# routes archives to LFS, so an accidental `git add .` would push all of it.
/hanny-kaggle.zip
/upload/